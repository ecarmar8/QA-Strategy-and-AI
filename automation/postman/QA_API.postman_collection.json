      "name": "API-00 Verify target identity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspace}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/health",
        "description": "API-00: local contract version 1.0. Isolated synthetic data."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API-00 HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Correct local target',()=>pm.expect(pm.response.json().target).to.eql('local-contract'));"
            ]
          }
        }
      ]
    },
