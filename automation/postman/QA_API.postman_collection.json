{
  "info": {
    "name": "QA Strategy | Local API Contract",
    "description": "Executable API automation in Postman. Local synthetic verification only; adapt contracts before use on a real product.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "workspace",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.info.requestName.startsWith('API-00 ')){pm.collectionVariables.set('workspace','qa-'+pm.variables.replaceIn('{{$guid}}'));}"
        ]
      }
    }
  ],
  "item": [
